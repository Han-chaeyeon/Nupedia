{
    "compilerOptions": {
        "target": "es5",
        "jsx": "react-jsx",
        "module": "commonjs",
        "moduleResolution": "node",
        "noEmit": true,
        "isolatedModules": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true
    },

    "include": [
        "src"
    ]


}